# ===== xiaoyi/rag 配置模板 =====
# 复制为 .env 后填入密钥（.env 不入版本库；环境变量优先于此文件）
# 说明：RAG 检索不需要聊天模型配置——回答生成由调用方（如 xiaoyi 主程序）负责。

# ---- 嵌入：bge-m3（入库构建索引 / 查询时嵌入问题） ----
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=

# ---- 重排：bge-reranker-v2-m3（检索精排） ----
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# 硅基流动单 key 方案：上面两个 KEY 都留空时，回退读 SILICONFLOW_API_KEY
# SILICONFLOW_API_KEY=

# ---- 门控（避免每轮都做检索；无关对话零开销） ----
# 相似度门控阈值：查询与知识库的最大余弦低于它 → 判定无关，跳过重排
# 实测参考：域内问题 ≥0.6，无关问题多 ≤0.5
RAG_GATE_MIN_SIMILARITY=0.55
# 域内关键词（英文逗号分隔；留空用内置小艺词表）
# RAG_GATE_KEYWORDS=小艺,鸿蒙,慧记,帮记,唤醒
# 重排分数阈值（门控第 3 层）：最高分低于它视为证据不足，不注入
RERANK_MIN_SCORE=0.3

# ---- 查询别名归一化（同音错字纠正：门控/嵌入/检索前生效，不改写用户消息） ----
RAG_ALIAS_NORMALIZE=1
# 自定义映射（"错字=正确"，英文逗号分隔）；留空用内置表（小易/小忆/小义/小依/小翼/小意/小议/小谊/晓艺 → 小艺）
# RAG_ALIAS_MAP=小易=小艺,小忆=小艺,小雨=小艺

# ---- 检索优化 ----
# 查询嵌入缓存（LRU，条数）：归一化后相同的查询复用向量，零 API 秒回
RAG_QUERY_CACHE_SIZE=64
# 目录软加权：命中块得分 × (1 + boost × 其类别得分份额)，抑制跨目录噪声；0 = 关闭
RAG_CATEGORY_BOOST=0.1
# 注入去重阈值：两块正文长片段（12 字滑窗）重合率 ≥ 该值 → 视为同一事实，只留高分那条
# 实测标定：真重复 0.17，其余组合 ≤0.03
RAG_DEDUPE_MIN_OVERLAP=0.10

# ---- 检索条数（三档：召回 → RRF 候选池 → 精排） ----
RECALL_TOP_K=10
CANDIDATE_TOP_K=10
KNOWLEDGE_TOP_K=5

# ---- 入库切块 ----
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=100

# ---- 索引校验严格模式（默认关闭） ----
# 关闭时：嵌入模型/切块参数/源文档指纹不一致 → 只告警仍加载（适合索引随仓库分发）
# 打开时：任一差异即判定失效，必须重新入库
# RAG_INDEX_STRICT=1
